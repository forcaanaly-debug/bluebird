# Copy these into your production host environment.
# Do not commit real secret values.
NODE_ENV=production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
REDIS_URL="redis://HOST:6379"
JWT_SECRET="replace-with-strong-random-secret-min-32-chars"
OTP_TTL_SECONDS=300
GOOGLE_AUTH_AUDIENCES="your-google-client-id.apps.googleusercontent.com"
APPLE_AUTH_AUDIENCES="com.bluebird.app"
