# Copy to .env — never commit real secrets
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://bluebird:bluebird@localhost:5432/bluebird?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-me-min-32-chars-random-string-here"
JWT_EXPIRES_DAYS=7

# Pilot: only Islamabad↔Gilgit city pairs allowed for trips + search filter
CORRIDOR_ISB_GILGIT_ONLY=true

# Dev OTP: fixed code for local testing only — ignored when NODE_ENV=production
DEV_OTP=000000
OTP_TTL_SECONDS=300

# Production / staging SMS (required when NODE_ENV=production)
# Twilio — set all three to send; otherwise use OTP_WEBHOOK_URL
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Generic webhook: POST JSON { "phone", "code" }; optional bearer OTP_WEBHOOK_SECRET
# OTP_WEBHOOK_URL=
# OTP_WEBHOOK_SECRET=

# Social auth audiences (comma-separated)
# Google: use OAuth client IDs that mint ID tokens for your app
GOOGLE_AUTH_AUDIENCES="your-google-web-or-native-client-id.apps.googleusercontent.com"
# Apple: bundle ID / service IDs expected in Apple identity token aud
APPLE_AUTH_AUDIENCES="com.bluebird.app"

# Optional Google OAuth web redirect flow
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_CALLBACK_URI=http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_SECRET=

# Seed admin (prisma db seed)
SEED_ADMIN_PHONE="+923001234567"
